# Образ Airflow с нашим кодом и его зависимостями.
#
# Почему не ставим проект целиком через pip install -e .: в зависимостях есть
# FastAPI и uvicorn, которые Airflow не нужны, а конфликтовать с его
# собственными пинами могут. Ставим только то, что действительно требуется
# заданиям загрузки, а сам код подключается через PYTHONPATH — его каталог
# монтируется томом, так что правка видна без пересборки образа.
FROM apache/airflow:3.3.2-python3.12

USER airflow

# Версии здесь не закреплены жёстко намеренно: Airflow ставится со своим
# constraints-файлом, и жёсткие пины наших библиотек дрались бы с ним.
RUN pip install --no-cache-dir \
    "clickhouse-connect[async]>=0.7" \
    "asyncpg>=0.29" \
    "pydantic-settings>=2.4" \
    "structlog>=24.4" \
    "orjson>=3.10" \
    "httpx>=0.27" \
    "tenacity>=9.0"
