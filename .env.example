# --- источник данных ---
# rest      — настоящий API goszakup.gov.kz
# fixtures  — локальные JSON-фикстуры из tests/fixtures/goszakup (работа без токена)
PA_SOURCE__KIND=fixtures
PA_SOURCE__BASE_URL=https://ows.goszakup.gov.kz/v3
PA_SOURCE__TOKEN=
PA_SOURCE__PAGE_LIMIT=50

# --- политика запросов ---
PA_HTTP__CONCURRENCY_START=4
PA_HTTP__CONCURRENCY_MIN=1
PA_HTTP__CONCURRENCY_MAX=16
PA_HTTP__REQUEST_TIMEOUT_S=30
PA_HTTP__CONNECT_TIMEOUT_S=10
PA_HTTP__RETRY_MAX_ATTEMPTS=5
PA_HTTP__RETRY_BASE_DELAY_S=0.5
PA_HTTP__RETRY_MAX_DELAY_S=60

# --- конвейер загрузки ---
PA_PIPELINE__QUEUE_MAXSIZE=32
PA_PIPELINE__BATCH_SIZE=500
PA_PIPELINE__PARSER_WORKERS=2
PA_PIPELINE__OVERALL_TIMEOUT_S=3600

# --- PostgreSQL (состояние синхронизации, справочники) ---
PA_POSTGRES__DSN=postgresql+asyncpg://procurement:procurement@localhost:5432/procurement

# --- ClickHouse (факты) ---
PA_CLICKHOUSE__HOST=localhost
PA_CLICKHOUSE__PORT=8123
PA_CLICKHOUSE__DATABASE=procurement
PA_CLICKHOUSE__USER=default
PA_CLICKHOUSE__PASSWORD=

# --- прочее ---
PA_LOG_LEVEL=INFO
PA_ENV=local
